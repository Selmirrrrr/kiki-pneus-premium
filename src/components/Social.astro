---
// Icônes de marque dessinées à la main (Lucide ne fournit plus les logos de marques).
import { site } from '../data/site';

const { class: className } = Astro.props;
---

<ul class:list={['social', className]}>
  <li>
    <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Kiki Pneus sur Facebook">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M14 21v-7.5h2.6l.4-3H14V8.6c0-.9.3-1.5 1.6-1.5H17V4.4A20 20 0 0 0 14.8 4C12.6 4 11 5.4 11 7.9v2.6H8.5v3H11V21z"
          fill="currentColor"></path>
      </svg>
    </a>
  </li>
  <li>
    <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Kiki Pneus sur Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </li>
</ul>

<style>
  .social {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hair-strong);
    border-radius: 50%;
    color: var(--ivory-dim);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .social a:hover {
    color: var(--ivory);
    border-color: var(--ivory);
  }
  .social svg {
    width: 16px;
    height: 16px;
  }
</style>
