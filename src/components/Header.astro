---
import { Image } from 'astro:assets';
import X from '@lucide/astro/icons/x';
import logo from '../assets/logo-light.png';
import { agencies, nav, site } from '../data/site';
import { link } from '../lib/url';
import BookingPanel from './BookingPanel.astro';
import Social from './Social.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === link(href) || path.startsWith(`${link(href)}/`);
---

{
  site.announcement && (
    <div class="announcement" role="status">
      <div class="container">
        <span class="italic">{site.announcement.title}</span> — {site.announcement.text}
      </div>
    </div>
  )
}

<div class="topbar">
  <div class="container topbar__inner">
    <span class="status" data-opening-status></span>
    <ul class="topbar__phones">
      {
        agencies.map((a) => (
          <li>
            <a href={a.phoneHref}>
              <span>{a.short}</span> {a.phone}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href={link('/')} class="header__logo" aria-label={`${site.name} — accueil`}>
      <Image src={logo} alt="" width={150} loading="eager" />
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={link(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <button class="btn btn--sm btn--ghost header__cta" popovertarget="rdv">Rendez-vous</button>
      <button class="header__burger" popovertarget="menu" aria-label="Ouvrir le menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="menu" popover class="menu">
  <div class="menu__head">
    <Image src={logo} alt="" width={130} />
    <button popovertarget="menu" popovertargetaction="hide" aria-label="Fermer le menu">
      <X aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Navigation mobile">
    <ol>
      {
        [{ href: '/', label: 'Accueil' }, ...nav].map((item, i) => (
          <li>
            <a href={link(item.href)} aria-current={item.href !== '/' && isActive(item.href) ? 'page' : undefined}>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <button class="btn" popovertarget="rdv">Prendre rendez-vous</button>
    <Social />
  </div>
</div>

<BookingPanel />

<style>
  .announcement {
    padding: 10px 0;
    background: var(--copper);
    color: var(--ink);
    font-size: 0.9rem;
    text-align: center;
  }
  .announcement .italic {
    font-size: 1.1rem;
  }

  .topbar {
    border-bottom: 1px solid var(--hair);
    font-size: 0.78rem;
    color: var(--stone);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 38px;
  }
  .topbar__phones {
    display: flex;
    gap: 28px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    letter-spacing: 0.04em;
  }
  .topbar__phones a {
    white-space: nowrap;
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .topbar__phones a:hover {
    color: var(--ivory);
  }
  .topbar__phones span {
    margin-right: 6px;
    color: var(--stone);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 12, 13, 0.78);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    border-bottom: 1px solid var(--hair);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
  }
  .header__logo :global(img) {
    width: 150px;
  }
  .header__nav {
    margin-left: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__nav a {
    position: relative;
    display: block;
    padding: 8px 0;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--copper);
    transform: translateX(-50%) scale(0);
    transition: transform 0.4s var(--ease);
  }
  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--ivory);
  }
  .header__nav a[aria-current='page']::after,
  .header__nav a:hover::after {
    transform: translateX(-50%) scale(1);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px;
    height: 44px;
    padding: 0 11px;
    border: 1px solid var(--hair-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .header__burger span {
    display: block;
    height: 1px;
    background: var(--ivory);
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px var(--gutter) 32px;
    border: 0;
    background: var(--ink);
    color: var(--ivory);
    flex-direction: column;
  }
  .menu:popover-open {
    display: flex;
    animation: fade 0.5s var(--ease);
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hair);
  }
  .menu__head button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hair-strong);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .menu ol {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .menu nav a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 9px 0;
    font-family: var(--serif);
    font-size: clamp(2.1rem, 9vw, 3rem);
    line-height: 1.1;
  }
  .menu nav a[aria-current='page'] {
    color: var(--copper);
  }
  .menu__num {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--stone);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 1180px) {
    .header__nav {
      display: none;
    }
    .header__actions {
      margin-left: auto;
    }
    .header__burger {
      display: flex;
    }
  }
  @media (max-width: 640px) {
    .topbar .status {
      display: none;
    }
    .topbar__phones {
      margin-inline: auto;
      gap: 18px;
    }
    .topbar__phones span {
      display: none;
    }
    .header__logo :global(img) {
      width: 120px;
    }
    .header__cta {
      min-height: 42px;
      padding: 0 16px;
      letter-spacing: 0.12em;
    }
  }
</style>
