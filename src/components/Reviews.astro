---
import { reviews } from '../data/site';
---

<section class="section reviews">
  <div class="container">
    <div class="reviews__head reveal">
      <div>
        <p class="label">Votre avis nous intéresse</p>
        <h2>Ils nous font <em>confiance</em></h2>
      </div>
      <p class="lead">
        Votre opinion compte. Vos commentaires nous aident à améliorer nos services : n'hésitez pas à nous faire part de
        vos suggestions et impressions.
      </p>
    </div>
    <ul class="reviews__grid">
      {
        reviews.map((r, i) => (
          <li class="review reveal" style={`--delay: ${(i % 3) * 0.1}s`}>
            <span class="review__stars" role="img" aria-label="5 étoiles sur 5">
              ★★★★★
            </span>
            <blockquote>
              <p>« {r.text} »</p>
            </blockquote>
            <span class="review__author">— {r.author}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 48px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .reviews__head h2 {
    margin: 0;
  }
  .reviews__head .lead {
    margin: 0;
  }
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
    border-left: 1px solid var(--hair);
  }
  .review {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(28px, 3.5vw, 48px);
    border-right: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    transition: background-color 0.5s var(--ease);
  }
  .review:hover {
    background: var(--ink-2);
  }
  .review__stars {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--copper);
  }
  blockquote {
    flex: 1;
    margin: 0;
  }
  blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1.2;
    color: var(--ivory);
  }
  .review__author {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--stone);
  }

  @media (max-width: 980px) {
    .reviews__head {
      grid-template-columns: 1fr;
    }
    .reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
