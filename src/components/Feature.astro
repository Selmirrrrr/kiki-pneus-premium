---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  index: number;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Photo plein cadre plutôt qu'un visuel détouré. */
  photo?: boolean;
  reverse?: boolean;
}

const { id, index, title, image, imageAlt = '', photo = false, reverse = false } = Astro.props;
const number = String(index).padStart(2, '0');
const hasVisual = Boolean(image) || Astro.slots.has('aside');
---

<article id={id} class:list={['feature', { 'feature--reverse': reverse, 'feature--solo': !hasVisual }]}>
  <div class="feature__body reveal">
    <p class="feature__num" aria-hidden="true">( {number} )</p>
    <h2>{title}</h2>
    <div class="feature__text">
      <slot />
    </div>
  </div>
  {
    hasVisual && (
      <div class:list={['feature__visual reveal', photo ? 'feature__visual--photo' : 'spotlight']} style="--delay: .15s">
        {image && <Image class:list={{ photo }} src={image} alt={imageAlt} widths={[320, 520, 760]} sizes="(max-width: 900px) 90vw, 540px" />}
        <slot name="aside" />
      </div>
    )
  }
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
    padding-block: clamp(72px, 9vw, 128px);
    border-top: 1px solid var(--hair);
  }
  .feature:first-child {
    border-top: 0;
  }
  .feature--reverse .feature__body {
    order: 2;
  }
  .feature--solo {
    grid-template-columns: minmax(0, 760px);
  }
  .feature__num {
    margin: 0 0 28px;
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--copper);
  }
  .feature h2 {
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    margin-bottom: 28px;
  }
  .feature__text {
    max-width: 56ch;
    font-size: 1.08rem;
  }
  .feature__text :global(ul) {
    padding-left: 1.1em;
  }
  .feature__text :global(li::marker) {
    color: var(--copper);
  }
  .feature__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 380px;
    padding: clamp(28px, 5vw, 64px);
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--ink-2), var(--ink));
  }
  .feature__visual :global(img) {
    max-height: 340px;
    width: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
  }
  .feature__visual--photo {
    padding: 0;
    overflow: hidden;
  }
  .feature__visual--photo :global(img) {
    width: 100%;
    height: 100%;
    max-height: none;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature--reverse .feature__body {
      order: 0;
    }
    .feature__visual {
      min-height: 300px;
    }
  }
</style>
