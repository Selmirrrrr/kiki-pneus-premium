---
import { Image } from 'astro:assets';
import logo from '../assets/logo-light.png';
import formatrice from '../assets/partners/entreprise-formatrice.jpg';
import pneuTotal from '../assets/partners/pneu-total.png';
import swissTyre from '../assets/partners/swiss-tyre-group.png';
import { agencies, hours, nav, partners, site } from '../data/site';
import { link } from '../lib/url';
import Social from './Social.astro';

const partnerLogos = { 'pneu-total': pneuTotal, 'swiss-tyre-group': swissTyre };
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <p class="footer__statement">
        Le pneu, <em>notre métier</em><br />depuis {site.founded}.
      </p>
      <div class="footer__brand">
        <a href={link('/')} aria-label={`${site.name} — accueil`}>
          <Image src={logo} alt="" width={170} />
        </a>
        <Social />
      </div>
    </div>

    <div class="footer__grid">
      <nav aria-label="Prestations">
        <h2>Prestations</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={link(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        agencies.map((a) => (
          <div>
            <h2>{a.short}</h2>
            <address>
              {a.street}
              <br />
              {a.zip} {a.city}
              <a href={a.phoneHref}>{a.phone}</a>
              <a href={`mailto:${a.email}`}>{a.email}</a>
            </address>
          </div>
        ))
      }

      <div>
        <h2>Horaires</h2>
        <dl>
          {
            hours.summary.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>
                  {h.time}
                  {'note' in h && <small>{h.note}</small>}
                </dd>
              </div>
            ))
          }
        </dl>
        <span class="status" data-opening-status></span>
      </div>
    </div>

    <div class="footer__partners">
      <div class="footer__values">
        <Image src={formatrice} alt="" width={48} />
        <span>Entreprise formatrice</span>
      </div>
      <ul>
        {
          partners.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener" aria-label={p.name}>
                <Image src={partnerLogos[p.logo]} alt="" height={32} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true">Kiki Pneus</div>

  <div class="container footer__legal">
    <span>© {year} {site.name} · Yverdon-les-Bains</span>
    <span>Prix en CHF, TVA incluse</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(88px, 10vw, 140px);
    border-top: 1px solid var(--hair);
    background: var(--ink);
    overflow: hidden;
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--hair);
  }
  .footer__statement {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    color: var(--ivory);
  }
  .footer__statement em {
    color: var(--copper);
  }
  .footer__brand {
    display: grid;
    justify-items: end;
    gap: 22px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.3fr;
    gap: 40px;
    padding-block: clamp(48px, 6vw, 72px);
  }
  .footer h2 {
    margin-bottom: 20px;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav li + li {
    margin-top: 8px;
  }
  nav a,
  address a {
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  nav a:hover,
  address a:hover {
    color: var(--ivory);
  }
  address {
    display: grid;
    gap: 2px;
    font-style: normal;
    line-height: 1.6;
  }
  address a:first-of-type {
    margin-top: 14px;
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--ivory);
  }
  dl {
    display: grid;
    gap: 14px;
    margin: 0 0 20px;
  }
  dt {
    color: var(--ivory);
  }
  dd {
    margin: 0;
  }
  dd small {
    display: block;
    margin-top: 4px;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--stone);
  }
  .footer__partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 28px;
    border-top: 1px solid var(--hair);
  }
  .footer__values {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .footer__values :global(img) {
    width: 40px;
    border-radius: var(--radius);
  }
  .footer__partners ul {
    display: flex;
    gap: 12px;
  }
  .footer__partners a {
    display: block;
    padding: 8px 14px;
    border-radius: var(--radius);
    background: var(--ivory);
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter 0.4s,
      opacity 0.4s;
  }
  .footer__partners a:hover {
    filter: none;
    opacity: 1;
  }
  .footer__partners :global(img) {
    height: 24px;
    width: auto;
  }
  .footer__wordmark {
    margin-top: clamp(24px, 4vw, 56px);
    font-family: var(--serif);
    font-size: clamp(5rem, 21vw, 21rem);
    line-height: 0.75;
    letter-spacing: -0.03em;
    white-space: nowrap;
    text-align: center;
    color: rgba(243, 239, 231, 0.05);
    user-select: none;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 24px 30px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--stone);
  }

  @media (max-width: 980px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__brand {
      justify-items: start;
    }
  }
</style>
