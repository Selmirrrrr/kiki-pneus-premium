---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import X from '@lucide/astro/icons/x';
import { agencies } from '../data/site';
---

<div id="rdv" popover class="booking" aria-labelledby="rdv-title">
  <button class="booking__close" popovertarget="rdv" popovertargetaction="hide" aria-label="Fermer">
    <X aria-hidden="true" />
  </button>
  <p class="label">Réservation en ligne</p>
  <h2 id="rdv-title">Choisissez votre <em>agence</em></h2>
  <p class="booking__intro">Réservez votre créneau en ligne en quelques clics, ou appelez-nous directement.</p>
  <ul class="booking__list">
    {
      agencies.map((a, i) => (
        <li>
          <a class="booking__agency" href={a.bookingUrl} target="_blank" rel="noopener">
            <span class="booking__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="booking__text">
              <span class="booking__name">{a.short}</span>
              <span class="booking__addr">
                {a.street}, {a.zip} {a.city}
              </span>
            </span>
            <ArrowUpRight class="booking__arrow" aria-hidden="true" />
          </a>
          <a class="booking__phone" href={a.phoneHref}>
            ou par téléphone · {a.phone}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .booking {
    width: min(600px, calc(100vw - 32px));
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid var(--hair-strong);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    color: var(--ivory-dim);
    box-shadow: var(--shadow-lg);
  }
  .booking:popover-open {
    animation: rise 0.6s var(--ease);
  }
  .booking::backdrop {
    background: rgba(5, 5, 6, 0.72);
    backdrop-filter: blur(6px);
  }
  .booking h2 {
    font-size: clamp(2.3rem, 6vw, 3.2rem);
  }
  .booking__close {
    position: absolute;
    top: 18px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--hair-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--ivory);
    cursor: pointer;
  }
  .booking__list {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }
  .booking__list li {
    border-bottom: 1px solid var(--hair);
    padding-bottom: 16px;
  }
  .booking__agency {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0 8px;
  }
  .booking__num {
    align-self: start;
    padding-top: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--stone);
  }
  .booking__text {
    display: grid;
    flex: 1;
  }
  .booking__name {
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1.1;
    color: var(--ivory);
    transition: color 0.3s;
  }
  .booking__addr {
    font-size: 0.92rem;
    color: var(--stone);
  }
  .booking__agency :global(.booking__arrow) {
    width: 26px;
    height: 26px;
    stroke-width: 1.3;
    color: var(--ivory);
    transition: transform 0.5s var(--ease);
  }
  .booking__agency:hover .booking__name {
    color: var(--copper);
  }
  .booking__agency:hover :global(.booking__arrow) {
    transform: translate(4px, -4px);
  }
  .booking__phone {
    margin-left: 42px;
    font-size: 0.85rem;
    color: var(--stone);
  }
  .booking__phone:hover {
    color: var(--ivory);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
