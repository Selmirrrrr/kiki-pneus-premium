---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Fuel from '@lucide/astro/icons/fuel';
import Route from '@lucide/astro/icons/route';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import Disc3 from '@lucide/astro/icons/disc-3';
import photo from '../assets/photos/geometrie.jpg';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import { chf, geometrie } from '../data/tarifs';
import Base from '../layouts/Base.astro';

const benefits = [
  { icon: ShieldCheck, title: 'Améliorer la sécurité' },
  { icon: Disc3, title: 'Augmenter la longévité des pneus' },
  { icon: Route, title: 'Améliorer la tenue de route' },
  { icon: Fuel, title: 'Économiser du carburant' },
];
---

<Base
  title="Géométrie et parallélisme"
  description="Contrôle et réglage de la géométrie de votre véhicule à Yverdon-les-Bains : sécurité, tenue de route, longévité des pneus. Dès CHF 160.00."
>
  <PageHero
    title="Géométrie"
    intro="Régler la géométrie de votre véhicule est une opération très importante, qui joue un rôle primordial pour un comportement routier optimal. Il est fortement conseillé de la faire contrôler tous les 2 ans."
  >
    <div class="price-tag">
      <span>{geometrie.from ? 'Dès' : ''}</span>
      <strong>{chf(geometrie.price)}</strong>
      <span>TVA incluse</span>
    </div>
  </PageHero>

  <section class="section">
    <div class="container geo">
      <div class="geo__photo reveal">
        <Image class="photo" src={photo} alt="Contrôle de la géométrie d'un véhicule sur banc de mesure" widths={[480, 660]} sizes="(max-width: 900px) 92vw, 560px" />
      </div>
      <div class="geo__text reveal" style="--delay: .1s">
        <p class="label">Pourquoi régler la géométrie ?</p>
        <h2>Une usure régulière, une conduite sûre</h2>
        <p class="lead">
          Une géométrie déréglée entraîne une usure irrégulière du pneu et diminue sa durée de vie. Un réglage correct vous
          permet de :
        </p>
        <ul class="benefits">
          {
            benefits.map((b) => (
              <li>
                <b.icon aria-hidden="true" />
                <span>{b.title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="alert reveal">
        <TriangleAlert class="alert__icon" aria-hidden="true" />
        <div>
          <h2>Un contrôle immédiat est nécessaire</h2>
          <p>Si vous avez heurté un obstacle (trottoir, nid-de-poule…) ou si vous constatez les problèmes suivants :</p>
          <ul>
            <li>vos pneus s’usent anormalement ;</li>
            <li>vous rencontrez des problèmes de direction ou de tenue de route.</li>
          </ul>
          <button class="btn btn--ink" popovertarget="rdv">Prendre rendez-vous <ArrowRight aria-hidden="true" /></button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .price-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 40px;
    padding: 16px 28px;
    border: 1px solid var(--hair-strong);
    border-radius: 999px;
  }
  .price-tag strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 2.3rem;
    line-height: 1;
  }
  .price-tag span {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .geo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
  }
  .geo__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .benefits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }
  .benefits li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 16px 22px 0;
    border-bottom: 1px solid var(--hair);
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.15;
    color: var(--ivory);
  }
  .benefits :global(svg) {
    flex: none;
    width: 24px;
    height: 24px;
    stroke-width: 1.2;
    color: var(--copper);
  }
  .alert {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 5vw, 64px);
    padding: clamp(32px, 6vw, 80px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--paper-muted);
  }
  .alert :global(.alert__icon) {
    width: clamp(40px, 5vw, 56px);
    height: clamp(40px, 5vw, 56px);
    stroke-width: 1;
    color: var(--copper-ink);
  }
  .alert h2 {
    color: var(--paper-ink);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
  }
  .alert ul {
    margin: 0 0 36px;
    padding-left: 1.2em;
    font-size: 1.1rem;
  }
  .alert li::marker {
    color: var(--copper-ink);
  }
  @media (max-width: 900px) {
    .geo {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .benefits,
    .alert {
      grid-template-columns: 1fr;
    }
  }
</style>
