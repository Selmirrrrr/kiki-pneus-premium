---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ogPhoto from '../assets/photos/agence-sud.jpg';
import { agencies, hours, site } from '../data/site';
import { link } from '../lib/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const og = await getImage({ src: ogPhoto, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? site.url);
// Une prévisualisation (ex. GitHub Pages) ne doit pas être indexée à la place du vrai site
const isPreview = new URL(Astro.site ?? site.url).hostname !== new URL(site.url).hostname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': agencies.map((a) => ({
    '@type': ['TireShop', 'AutoRepair'],
    '@id': `${site.url}/#${a.id}`,
    name: a.name,
    url: site.url,
    image: ogUrl.href,
    telephone: a.phone.replace(/^0/, '+41 '),
    email: a.email,
    foundingDate: String(site.founded),
    priceRange: 'CHF',
    address: {
      '@type': 'PostalAddress',
      streetAddress: a.street,
      postalCode: a.zip,
      addressLocality: a.city,
      addressRegion: 'VD',
      addressCountry: 'CH',
    },
    ...(a.geo && { geo: { '@type': 'GeoCoordinates', latitude: a.geo.lat, longitude: a.geo.lng } }),
    openingHoursSpecification: hours.weekdays.map(([opens, closes]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens,
      closes,
    })),
    sameAs: [site.social.facebook, site.social.instagram],
  })),
};
---

<!doctype html>
<html lang="fr-CH" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={link('/favicon.ico')} sizes="any" />
    <meta name="theme-color" content="#0c0c0d" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      import { hydrateOpeningStatus } from '../lib/opening';

      hydrateOpeningStatus();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
